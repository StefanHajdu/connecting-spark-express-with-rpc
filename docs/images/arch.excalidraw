      "isDeleted": false,
      "boundElements": [],
      "updated": 1754340727966,
      "link": null,
      "locked": false,
      "text": "startIndex = sumitted node index\n\nupdated_nodes = []\nfor each index from startIndex:\n    node = get_node(index)\n    prev_node = nodes[index-1]\n    try:\n        node.df = node.run_transform(spark, prev_node.df)\n        add_valid_node(updated_nodes, index)\n    except SparkMissingColumnException:\n        add_invalid_nodes(updated_nodes, index)\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "OxyGmVCZx9AaLu43fEoNi",
      "originalText": "startIndex = sumitted node index\n\nupdated_nodes = []\nfor each index from startIndex:\n    node = get_node(index)\n    prev_node = nodes[index-1]\n    try:\n        node.df = node.run_transform(spark, prev_node.df)\n        add_valid_node(updated_nodes, index)\n    except SparkMissingColumnException:\n        add_invalid_nodes(updated_nodes, index)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
