    {
      "type": "text",
      "version": 2275,
      "versionNonce": 2115796750,
      "isDeleted": false,
      "id": "yJUtuvlnioy3BugXwXPW3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1489.5993635417767,
      "y": 1857.4580695469897,
      "strokeColor": "#ffffff",
      "backgroundColor": "#1e1e1e",
      "width": 820.3125,
