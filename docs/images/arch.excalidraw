      "updated": 1754340884970,
      "link": null,
      "locked": false,
      "text": "for each node in updated_nodes:\n    UiNode = findUiNode(node.id)\n    UiNode.columnsOnNodeInput = ui_node.getPrevNode().columnOnNodeOutput\n    UiNode.columnsOnNodeOutput = node.columns\n    UiNode.InvalidStatus = node.invalid",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "JBwsB0VR1S2gJztbdJEr3",
      "originalText": "for each node in updated_nodes:\n    UiNode = findUiNode(node.id)\n    UiNode.columnsOnNodeInput = ui_node.getPrevNode().columnOnNodeOutput\n    UiNode.columnsOnNodeOutput = node.columns\n    UiNode.InvalidStatus = node.invalid",
      "autoResize": true,
      "lineHeight": 1.25
