      "text": "for each index from failed_index:\n    node = nodes[index]\n    \n    updated_nodes.append(\n        {\n            id: node.id\n            columns: node.columns\n            valid: {value: False, reason: \"Missing columns in node id {node.id}\"}\n        }\n    )\n",
