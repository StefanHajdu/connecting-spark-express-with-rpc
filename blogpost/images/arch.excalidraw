    {
      "type": "text",
      "version": 2249,
      "versionNonce": 396534603,
      "isDeleted": false,
      "id": "yJUtuvlnioy3BugXwXPW3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1492.1022627116986,
      "y": 1845.6203467686694,
      "strokeColor": "#ffffff",
      "backgroundColor": "#1e1e1e",
      "width": 820.3125,
      "height": 696,
      "seed": 1883123493,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1739716291339,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "POST /addSql; body transform_to_add: {\n                    id,\n                    previous_id,\n                    query_type,\n                    query,\n                    query_params_json          \n                }\n\n- (__proxy) get session by id\n- (__proxy) sends transform_to_add + session's plan_log\n\n- (session) recives transform_to_add + session's plan_log\n- (session) if transform_to_add.is_after_cache():\n                plan_log = plan_log.cut_from_cached()\n            else\n                unpersist current_df\n                current_df = init_df\n- (session) for each log_transform in plan_log:\n                if log_transform.id is transform_to_add.previous_id:\n                    current_df = current_df.applySql(log_transfrom)\n                    current_df = current_df.applySql(transform_to_add)\n                else\n                    current_df = current_df.applySql(log_transfrom)\n- (session) cache current_df\n- (session) sends new plan_log\n\n- (__proxy) receives new_plan_log\n- (__proxy) overwrite plan_log with new_plan_log\n- (__proxy) notify child sessions about plan change",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "k-t0fxbJEsKH0xaDL8kDH",
      "originalText": "POST /addSql; body transform_to_add: {\n                    id,\n                    previous_id,\n                    query_type,\n                    query,\n                    query_params_json          \n                }\n\n- (__proxy) get session by id\n- (__proxy) sends transform_to_add + session's plan_log\n\n- (session) recives transform_to_add + session's plan_log\n- (session) if transform_to_add.is_after_cache():\n                plan_log = plan_log.cut_from_cached()\n            else\n                unpersist current_df\n                current_df = init_df\n- (session) for each log_transform in plan_log:\n                if log_transform.id is transform_to_add.previous_id:\n                    current_df = current_df.applySql(log_transfrom)\n                    current_df = current_df.applySql(transform_to_add)\n                else\n                    current_df = current_df.applySql(log_transfrom)\n- (session) cache current_df\n- (session) sends new plan_log\n\n- (__proxy) receives new_plan_log\n- (__proxy) overwrite plan_log with new_plan_log\n- (__proxy) notify child sessions about plan change",
      "lineHeight": 1.2,
      "baseline": 690
    },
