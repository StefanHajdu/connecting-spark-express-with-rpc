      "boundElements": [],
      "updated": 1739050340590,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "#2 sends request to #1 to ask for serialized plan\n#1 receives requests\n    - if #2 is already linked check hash plan diff\n        - if plan changed\n            - #1 serialize plan\n            - #1 sends serialized plan\n            - #2 receives the serialized plan\n            - #2 applies plan items to #2's df in loop\n        - else\n            - #1 sends NOT_CHANGED_CODE\n            - #2 has current version of #1 session",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "tPjq7Y3DT5cIW2hJQBp5b",
      "originalText": "#2 sends request to #1 to ask for serialized plan\n#1 receives requests\n    - if #2 is already linked check hash plan diff\n        - if plan changed\n            - #1 serialize plan\n            - #1 sends serialized plan\n            - #2 receives the serialized plan\n            - #2 applies plan items to #2's df in loop\n        - else\n            - #1 sends NOT_CHANGED_CODE\n            - #2 has current version of #1 session",
      "lineHeight": 1.25,
      "baseline": 267
    },
