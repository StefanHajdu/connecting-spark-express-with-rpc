{
  "folders": [
    {
      "name": "root",
      "path": "../"
    },
    {
      "path": "../spark_api"
    },
    {
      "path": "../service"
    },
    {
      "path": "../client_app"
    },
    {
      "path": "../protos"
    }
  ],
  "settings": {
    "files.exclude": {
      "spark_api": true,
      "service": true,
      "client_app": true,
      "protos": true,
      "**/**__pycache__": true,
      "**/**.egg-info": true,
      "**/**.pytest_cache": true,
      "**/node_modules": true
    },
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.stubPath": "${workspaceFolder}/lib",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
  }
}
